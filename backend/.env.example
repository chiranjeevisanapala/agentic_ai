# Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database (Default SQLite, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./support_system.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/support_db

# Security & JWT
SECRET_KEY=super-secret-jwt-key-agentic-ai-customer-support-2025
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM API Keys (Optional - System automatically runs deterministic reasoning if omitted, or leverages Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=auto

# Redis Session Memory (Optional)
REDIS_URL=

# Escalation Boundaries
REFUND_AUTO_APPROVE_LIMIT=100.0
